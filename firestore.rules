rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // 기존 프로젝트에 적용할 때는 아래 2개 match 블록을 기존 규칙 안에 추가하세요.
  // 기존 images 등 다른 컬렉션 규칙을 이 파일로 덮어쓰지 마세요.
  function hub4SignedIn(){return request.auth != null;}
  function hub4Owner(postId){return hub4SignedIn() && get(/databases/$(database)/documents/hub4Posts/$(postId)).data.owner == request.auth.uid;}
  function hub4ValidPost(d){return d.keys().hasOnly(['id','owner','theme','title','description','content','status','created','updated','published','version'])
   && d.id is int && d.id > 0 && d.owner is string
   && d.theme in ['travel','food','life','product','golf'] && d.title is string && d.title.size() <= 180
   && d.description is string && d.content is string && d.content.size() <= 300000
   && d.status in ['reserved','generating','failed','published','draft','deleted']
   && d.created is string && d.updated is string && (d.published == null || d.published is string)
   && d.version is int && d.version >= 0
   && (!(d.status in ['published','draft']) || (d.content.size() > 0 && d.version >= 1));}
  match /hub4Counters/posts {
   allow get: if hub4SignedIn();
   allow create: if hub4SignedIn() && request.resource.data.keys().hasOnly(['nextId','updated']) && request.resource.data.nextId == 1
    && getAfter(/databases/$(database)/documents/hub4Posts/1).data.owner == request.auth.uid;
   allow update: if hub4SignedIn() && request.resource.data.keys().hasOnly(['nextId','updated'])
    && request.resource.data.nextId == resource.data.nextId + 1
    && getAfter(/databases/$(database)/documents/hub4Posts/$(string(request.resource.data.nextId))).data.owner == request.auth.uid
    && getAfter(/databases/$(database)/documents/hub4Posts/$(string(request.resource.data.nextId))).data.status == 'reserved';
   allow delete,list: if false;
  }
  match /hub4Posts/{postId} {
   allow get,list: if resource.data.status == 'published' || (hub4SignedIn() && resource.data.owner == request.auth.uid);
   allow create: if hub4SignedIn() && hub4ValidPost(request.resource.data) && request.resource.data.owner == request.auth.uid
    && postId == string(request.resource.data.id) && request.resource.data.status == 'reserved' && request.resource.data.content == '' && request.resource.data.version == 0
    && getAfter(/databases/$(database)/documents/hub4Counters/posts).data.nextId == request.resource.data.id;
   allow update: if hub4SignedIn() && resource.data.owner == request.auth.uid && hub4ValidPost(request.resource.data)
    && request.resource.data.owner == resource.data.owner && request.resource.data.id == resource.data.id
    && request.resource.data.created == resource.data.created && request.resource.data.theme == resource.data.theme
    && resource.data.status != 'deleted'
    && (request.resource.data.version == resource.data.version || request.resource.data.version == resource.data.version + 1)
    && (request.resource.data.content == resource.data.content || resource.data.content == ''
     || (request.resource.data.version == resource.data.version + 1
      && getAfter(/databases/$(database)/documents/hub4Posts/$(postId)/revisions/$(string(resource.data.version))).data.content == resource.data.content));
   allow delete: if false;
   match /private/{docId} {
    allow get,create,update,delete: if hub4Owner(postId);
   }
   match /revisions/{revisionId} {
    allow get,list: if hub4Owner(postId);
    allow create: if hub4Owner(postId) && request.resource.data.owner == request.auth.uid
     && revisionId == string(request.resource.data.version)
     && request.resource.data.content == get(/databases/$(database)/documents/hub4Posts/$(postId)).data.content
     && request.resource.data.version == get(/databases/$(database)/documents/hub4Posts/$(postId)).data.version
     && getAfter(/databases/$(database)/documents/hub4Posts/$(postId)).data.version == request.resource.data.version + 1;
    allow update,delete: if false;
   }
  }
 }
}
